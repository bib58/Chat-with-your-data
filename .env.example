# Frontend (Vite/Vercel)
VITE_API_URL=http://localhost:8000

# Backend (FastAPI/Render)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_GUARDRAILS=true
CORS_ORIGINS=http://localhost:5173,https://data-chit-chat.vercel.app

# LangSmith observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=chat-with-your-data-local

# Neon PostgreSQL feedback database URL (keep this secret and set it only on the backend).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional pricing supplied by the operator in USD per one million tokens.
# Leave unset when the provider/model does not publish reliable pricing.
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
LLM_REASONING_COST_PER_1M_USD=
