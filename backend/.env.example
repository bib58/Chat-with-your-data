# ============================================================
# Chat-with-your-data – Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ------------------------------------------------------------
# Google / Gemini
# ------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
# Optional: override the default model
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Guardrails
# ------------------------------------------------------------
# Set to false to disable input/output guardrails (not recommended for production)
ENABLE_GUARDRAILS=true

# ------------------------------------------------------------
# SQL Server (optional – only needed for the "Connect" feature)
# ------------------------------------------------------------
# Example: mssql+pymssql://user:password@server:1433/dbname
# DB_CONNECTION_STRING=

# ------------------------------------------------------------
# LangSmith Observability (https://smith.langchain.com)
# ------------------------------------------------------------
# Enable automatic tracing of all LangChain / LangGraph calls
LANGCHAIN_TRACING_V2=true

# Your LangSmith API key (create one at https://smith.langchain.com/settings)
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Project name in LangSmith where traces will be grouped
LANGCHAIN_PROJECT=chat-with-your-data

# LangSmith API endpoint (leave as-is unless using a self-hosted instance)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
