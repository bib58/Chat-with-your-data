# ============================================================
# LLM Benchmarking – Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ------------------------------------------------------------
# OpenRouter (required for benchmarking)
# ------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------
# LangSmith Observability (https://smith.langchain.com)
# ------------------------------------------------------------
# Enable automatic tracing of all LangChain calls during benchmarks
LANGCHAIN_TRACING_V2=true

# Your LangSmith API key (create one at https://smith.langchain.com/settings)
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Benchmark traces go to a separate project for clean comparison analysis
# Change to "chat-with-your-data" if you prefer all traces in one project
LANGCHAIN_PROJECT=chat-with-data-benchmarks

# LangSmith API endpoint (leave as-is unless using a self-hosted instance)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
